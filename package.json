{
  "name": "cityfeed-ai",
  "version": "1.0.0",
  "description": "CityFeed AI - A smart city management platform",
  "main": "dist/server.js",
  "scripts": {
    "start": "node dist/server.js",
    "dev": "npx nodemon --exec \"npx ts-node\" src/server.ts",
    "build": "rimraf dist && node --max-old-space-size=4096 ./node_modules/.bin/tsc",
    "postbuild": "npm run copy-files",
    "copy-files": "node scripts/copy-files.js",
    "start:mem": "node scripts/dev-mem.js",
    "start:dist": "node scripts/start-dist.js",
    "clean": "rimraf dist",
    "lint": "eslint . --ext .ts",
    "prestart": "rimraf dist && node --max-old-space-size=4096 ./node_modules/.bin/tsc",
    "test-email": "ts-node src/scripts/test-email.ts",
    "test-email-prod": "ts-node src/scripts/production-email-test.ts",
    "test-email-railway": "ts-node src/scripts/railway-email-test.ts",
    "railway-debug": "ts-node src/scripts/railway-debug.ts",
    "railway-email-diagnostic": "ts-node src/scripts/railway-email-diagnostic.ts",
    "test-sendgrid": "ts-node src/scripts/test-sendgrid.ts",
    "test-swagger": "ts-node src/scripts/test-swagger-config.ts",
    "test": "jest --config jest.config.js",
    "test:user": "jest --testPathPattern=user.test.ts",
    "test:super-admin": "jest --testPathPattern=super-admin.test.ts"
  },
  "keywords": [
    "smart-city",
    "ai",
    "management",
    "platform"
  ],
  "author": "CityFeed AI Team",
  "license": "ISC",
  "dependencies": {
    "@prisma/client": "^5.10.2",
    "@sendgrid/mail": "8.1.5",
    "@typegoose/typegoose": "12.19.0",
    "@types/bcrypt": "^5.0.2",
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.18",
    "@types/express": "^4.17.22",
    "@types/express-validator": "3.0.2",
    "@types/helmet": "^0.0.48",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/morgan": "^1.9.9",
    "@types/node": "^20.17.57",
    "@types/node-cron": "^3.0.11",
    "@types/socket.io": "^3.0.1",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "@types/twilio": "^3.19.2",
    "@typescript-eslint/eslint-plugin": "^7.1.1",
    "@typescript-eslint/parser": "^7.1.1",
    "bcryptjs": "^2.4.3",
    "cityfeed-ai": "file:",
    "class-transformer": "0.5.1",
    "class-validator": "0.14.2",
    "cloudinary": "^2.6.1",
    "cors": "^2.8.5",
    "crypto": "1.0.1",
    "dotenv": "^16.4.5",
    "eslint": "^8.57.0",
    "express": "^4.18.2",
    "express-rate-limit": "^7.5.1",
    "express-validator": "7.2.1",
    "helmet": "^7.2.0",
    "inversify": "6.2.2",
    "inversify-express-utils": "6.5.0",
    "jsonwebtoken": "^9.0.2",
    "module-alias": "2.2.3",
    "mongoose": "^8.2.1",
    "morgan": "^1.10.0",
    "multer": "1.4.5-lts.1",
    "node-cron": "^3.0.3",
    "openai": "^4.28.0",
    "pdfkit": "^0.17.1",
    "prisma": "^5.10.2",
    "qrcode": "^1.5.4",
    "razorpay": "^2.9.6",
    "reflect-metadata": "0.2.2",
    "rimraf": "^5.0.5",
    "sendgrid": "5.2.3",
    "socket.io": "^4.8.1",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "twilio": "^5.7.1",
    "winston": "^3.17.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/multer": "1.4.7",
    "@types/supertest": "^6.0.3",
    "jest": "^30.0.3",
    "mongodb-memory-server": "10.2.1",
    "nodemon": "3.1.10",
    "supertest": "^7.1.1",
    "ts-jest": "^29.4.0",
    "ts-node": "10.9.2",
    "tsconfig-paths": "4.2.0",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "resolutions": {
    "typescript": "^5.3.3"
  }
}
